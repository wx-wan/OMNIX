# Dependencies
node_modules/
.pnpm-store/
.npm/

# Build output
dist/
build/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Prisma generated client (regenerate via prisma generate)
# server/src/generated/ is git-ignored by default in prisma output config below

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS / Editor
.DS_Store
.idea/
.vscode/
*.swp

# Local DB dumps
*.dump

# Uploaded product images (runtime artifacts, regenerated via /upload)
server/uploads/

# Coverage
coverage/

# Playwright CLI 运行时产物（下载的 xlsx、控制台日志等）
client/.playwright-cli/
