// Prisma schema — OMNIX 后端
// 生成客户端：npx prisma generate
// 建表/迁移：npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  low
  medium
  high
}

// 统一往来单位 / 联系人类型：客户、供应商、用户（系统账号）
enum ContactType {
  customer
  supplier
  user
}

// CRM 销售阶段（看板列）
model Stage {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  accent    String   @default("bg-slate-400") // 阶段强调色（tailwind 背景类）
  position  Int      @default(0)
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stages")
}

// 统一往来单位 / 联系人（扁平化单表）
// - type 区分 客户 / 供应商 / 用户
// - name 为组织名称（公司）或个人姓名
// - company 为个人所属公司（当本条为「个人」时填写）
// - password / role 仅 type=user 用于登录
model Contact {
  id        String      @id @default(cuid())
  type      ContactType @default(customer)
  name      String // 组织名称 或 个人姓名 *
  company   String? // 个人所属公司
  email     String? @unique // 邮箱唯一（登录按邮箱定位）
  phone     String?
  country   String? // 国家地区
  website   String? // 官网
  password  String? // 仅 type=user 用于登录
  role      String? // 仅 type=user：admin | user
  deals     Deal[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([type])
  @@map("contacts")
}

// 产品（新建商机时落库；也可在「产品」页独立维护）
model Product {
  id          String   @id @default(cuid())
  name        String // 产品名称 *
  category    String? // 类别
  spec        String? // 规格 / 型号
  price       Decimal? @db.Decimal(12, 2) // 单价（元）
  quantity    Int      @default(1) // 数量
  unit        String? // 单位
  description String? // 描述
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

// CRM 交易/线索卡片（关联一个往来单位与一个产品）
model Deal {
  id          String    @id @default(cuid())
  title       String // 商机名称（可由往来单位 + 产品派生）
  description String?
  tag         String? // 新签 / 续约 等
  priority    Priority  @default(medium)
  amount      Decimal?  @db.Decimal(12, 2) // 金额（元，可由 单价×数量 派生）
  assignee    String? // 业务员
  meta        String? // 备注 / 日期
  stage       Stage     @relation(fields: [stageId], references: [id])
  stageId     String
  position    Int       @default(0) // 同阶段内排序
  contact     Contact?  @relation(fields: [contactId], references: [id])
  contactId   String?   @map("contact_id")
  product     Product?  @relation(fields: [productId], references: [id])
  productId   String?   @map("product_id")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([stageId])
  @@index([contactId])
  @@index([productId])
  @@map("deals")
}
