// Prisma schema — OMNIX 后端
// 生成客户端：npx prisma generate
// 建表/迁移：npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  low
  medium
  high
}

// 统一往来单位 / 联系人类型：客户、供应商、用户（系统账号）
enum ContactType {
  customer
  supplier
  user
}

// CRM 销售阶段（看板列）
model Stage {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  accent    String   @default("bg-slate-400") // 阶段强调色（tailwind 背景类）
  position  Int      @default(0)
  deals     Deal[]
  stageLogs DealStageLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stages")
}

// 统一往来单位 / 联系人（扁平化单表，贴近 Odoo res.partner 范式）
// - type 区分 客户 / 供应商 / 用户
// - name 为组织名称（公司）或个人姓名
// - isCompany 标记本条是否为「公司」（Odoo 的 is_company）
// - parentId / parent / children 构成自关联：个人指向所属公司，公司下挂其联系人
//   （双向关联，等价于 Odoo 的 parent_id / child_ids）
// - company 为旧版个人所属公司文本，迁移脚本已将其转为 parentId 关联并清空；仅作历史兼容
// - password / role 仅 type=user 用于登录
model Contact {
  id        String      @id @default(cuid())
  type      ContactType @default(customer)
  customerType String? // 客户类型（业务类型：终端客户/贸易商/工厂 等；区别于 type 实体类型）
  name      String // 组织名称 或 个人姓名 *
  company   String? // 旧版个人所属公司文本（迁移后清空，展示改用 parent.name）
  isCompany Boolean   @default(false) @map("is_company") // 是否为公司（区别于个人联系人）
  parentId  String?   @map("parent_id") // 所属公司（个人指向公司，自关联）
  parent    Contact?  @relation("CompanyChildren", fields: [parentId], references: [id])
  children  Contact[] @relation("CompanyChildren")
  email     String? @unique // 邮箱唯一（登录按邮箱定位）
  phone     String?
  country   String? // 国家地区
  website   String? // 官网
  password  String? // 仅 type=user 用于登录
  role      String? // 仅 type=user：admin | user
  position  String? // 职位（设计 / 跟单 等；管理员可配置，用于设计单/打样单协助负责人筛选）
  isSystem  Boolean @default(false) // 系统级机器人（如 ominXBot），拥有最高权限并负责记录操作历史
  botCharacter String? @default("mochi") // 系统机器人的 3D 形象（wobnimo 角色 id），仅 isSystem 使用
  avatarUrl String? @map("avatar_url") // 头像 URL（如 MCP 代理用户 Accio work 用 web 头像）
  aiGenerated Boolean @default(false) @map("ai_generated") // 是否由 Accio AI 抓取生成（信息不保真，待核实）
  archived  Boolean @default(false) @map("archived") // 归档：关联了商机的往来单位不允许删除，只能归档隐藏
  deals     Deal[]
  quotations Quotation[]
  designResponsible DesignOrder[] @relation("DesignOrderResponsible")
  designAssistant   DesignOrder[] @relation("DesignOrderAssistant")
  sampleResponsible SampleOrder[] @relation("SampleOrderResponsible")
  ecoRequested      EngineeringChange[] @relation("EcoRequestedBy")
  ecoApproved       EngineeringChange[] @relation("EcoApprovedBy")
  sampleAssistant   SampleOrder[] @relation("SampleOrderAssistant")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([type])
  @@index([parentId])
  // 列表高频过滤组合：isCompany + archived（公司维护表 / 归档切换）+ 按 createdAt 倒序分页
  @@index([isCompany, archived])
  @@index([createdAt])
  @@map("contacts")
}

// 产品（新建商机时落库；也可在「产品」页独立维护）
model Product {
  id          String   @id @default(cuid())
  name        String? // 产品名称（设计单完善；与 description 区分；MCP 同步不写）
  description String? // 描述（仅系统内人工维护，MCP 同步不覆盖）
  sourceProductId String? @map("source_product_id") // 外部平台商品编号（MCP 引流归因/去重，避免重复建产品）
  mode        String? // 模式
  process     String? // 工艺
  audience    String? // 受众
  category    String? // 品类
  price       Decimal? @db.Decimal(12, 2) // 单价（元）
  costPrice   Decimal? @db.Decimal(12, 2) // 成本价（元）
  tax         Decimal? @db.Decimal(5, 2) // 税项（%）
  image       String? // 产品主图 URL（上传接口返回）
  quantity    Int      @default(0) // 数量
  unit        String? // 单位（台 / 个 / 件 …）

  // —— PLM：生命周期 / 版本 / 文档 ——
  status        String   @default("requirement") @map("status") // requirement|designing|reviewing|released|obsolete
  releasedAt    DateTime? @map("released_at") // 发布时间（状态置为 released 时写入）
  obsoletedAt   DateTime? @map("obsoleted_at") // 停用时间（状态置为 obsolete 时写入）
  partNo        String?  @map("part_no") // 产品编号 / 物料号（同一产品的多版本共享，用于版本分组）
  revision      String   @default("A") @map("revision") // 版本号 A / B / C …
  revisionParentId String? @map("revision_parent_id") // 上一版本 id（构成版本链）
  revisionParent Product?  @relation("ProductRevisions", fields: [revisionParentId], references: [id])
  revisionChildren Product[] @relation("ProductRevisions")
  drawings      Json? // 该版本图纸 / 3D / 规格 PDF [{name,url}]

  // —— Phase 4：分类与参数化规格 ——
  categoryId   String?  @map("category_id") // 所属分类（树节点）
  categoryRef  ProductCategory? @relation("ProductCategory", fields: [categoryId], references: [id])
  specs        Json? // 参数化规格值：{ [attributeKey]: value }（结构由分类的 specTemplate 定义）

  parentId    String?   @map("parent_id") // 变体来源产品 id（为空=标准产品）
  parent      Product?  @relation("ProductVariants", fields: [parentId], references: [id])
  variants    Product[] @relation("ProductVariants")
  isRequirement Boolean  @default(false) @map("is_requirement") // 是否为需求阶段新建的产品（需求产品）
  archived     Boolean  @default(false) @map("archived") // 归档：关联了商机的产品不允许删除，只能归档隐藏
  deals       Deal[]
  designOrders DesignOrder[] @relation("ProductDesignOrders")
  sampleOrders SampleOrder[] @relation("ProductSampleOrders")
  bomAsParent  BomItem[] @relation("ProductBomParent") // 作为父件时的 BOM 行
  bomAsChild   BomItem[] @relation("ProductBomChild") // 作为子件时（where-used）
  ecoLinks     EcoProduct[] @relation("EcoProducts") // 被哪些工程变更影响
  createdAt   DateTime @default(now())

  @@index([sourceProductId])
  updatedAt   DateTime @updatedAt

  @@index([parentId])
  @@index([partNo])
  @@map("products")
}

// BOM（物料清单）：多级装配结构。父件（装配）由若干子件（零件/部件）组成，
// 每行含数量与位号；where-used 通过 childProductId 反查。
model BomItem {
  id              String   @id @default(cuid())
  parentProductId String   @map("parent_product_id") // 父件（装配）
  parent          Product  @relation("ProductBomParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  childProductId  String   @map("child_product_id") // 子件（零件/部件）
  child           Product  @relation("ProductBomChild", fields: [childProductId], references: [id], onDelete: Cascade)
  quantity        Int      @default(1) @map("quantity") // 单装数量
  position        String?  @map("position") // 位号 / 序号
  note            String?  @map("note")
  createdAt       DateTime @default(now())

  @@index([parentProductId])
  @@index([childProductId])
  @@map("bom_items")
}

// 产品分类树（Phase 4）：自引用的多级分类；每个分类可挂参数化规格模板。
model ProductCategory {
  id           String           @id @default(cuid())
  name         String
  parentId     String?          @map("parent_id")
  parent       ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     ProductCategory[] @relation("CategoryTree")
  position     Int              @default(0)
  specTemplate Json?            @map("spec_template") // 参数化规格模板：[{ key, label, type, unit?, options?, required? }]
  products     Product[]        @relation("ProductCategory")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([parentId])
  @@map("product_categories")
}

// 工程变更 ECO（Phase 3）：记录产品/版次/ BOM 的正式变更，含审批与实施。
model EngineeringChange {
  id            String           @id @default(cuid())
  number        String           @unique // EC0001 自增编号
  title         String
  description   String?
  status        String           @default("draft") @map("status") // draft|review|approved|implemented|closed|cancelled
  reason        String? // 变更原因
  impact        String? // 影响分析（成本/交期/合规等）
  requestedById String?          @map("requested_by_id")
  requestedBy   Contact?         @relation("EcoRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?          @map("approved_by_id")
  approvedBy    Contact?         @relation("EcoApprovedBy", fields: [approvedById], references: [id])
  effectiveDate DateTime?        @map("effective_date") // 生效日期
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  products      EcoProduct[]

  @@map("engineering_changes")
}

// ECO 影响的产品（多对多）：一条 ECO 可影响多个产品（及各自版本）。
model EcoProduct {
  id        String            @id @default(cuid())
  ecoId     String            @map("eco_id")
  eco       EngineeringChange @relation(fields: [ecoId], references: [id], onDelete: Cascade)
  productId String            @map("product_id")
  product   Product           @relation("EcoProducts", fields: [productId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime          @default(now())

  @@index([ecoId])
  @@index([productId])
  @@map("eco_products")
}

// CRM 交易/线索卡片（关联一个往来单位与一个产品）
model Deal {
  id          String    @id @default(cuid())
  title       String // 商机名称（可由往来单位 + 产品派生）
  description String?
  tag         String? // 新签 / 续约 等
  priority    Priority  @default(medium)
  amount      Decimal?  @db.Decimal(12, 2) // 金额（元，可由 单价×数量 派生）
  assignee    String? // 业务员
  meta        String? // 备注 / 日期
  source      String? // 来源（官网 / 转介绍 / 展会 等）
  stage       Stage     @relation(fields: [stageId], references: [id])
  stageId     String
  position    Int       @default(0) // 同阶段内排序
  contact     Contact?  @relation(fields: [contactId], references: [id])
  contactId   String?   @map("contact_id")
  product     Product?  @relation(fields: [productId], references: [id])
  productId   String?   @map("product_id")
  linesJson   String? @map("lines_json") // 订单明细（含组合/备注/排序；行级数量与折扣随行存；空 productId 的产品行会落入产品库）
  priceIncludeTax Boolean @default(true) @map("price_include_tax") // 价格是否含税：true=单价含税（倒算税额），false=单价不含税（税额另计）
  quotations  Quotation[]
  fees        Fee[]
  designOrders DesignOrder[]
  sampleOrders SampleOrder[]
  stageLogs   DealStageLog[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([stageId])
  @@index([contactId])
  @@index([productId])
  @@map("deals")
}

// 费用单：按商机归集的费用明细（设计费 / 样品费 / 物流费 等），全部集中在费用单展示。
// 推进到「样品」阶段时，后端/前端会检查是否存在 type=样品费 的费用。
model Fee {
  id        String   @id @default(cuid())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId    String   @map("deal_id")
  type      String // 费用类型（如 样品费 / 设计费 / 物流费 / 其他）
  amount    Decimal  @db.Decimal(12, 2) // 金额（元，CNY）
  note      String? // 备注（如费用说明 / 凭证号）
  voucherUrl String? @map("voucher_url") // 旧版单图凭证 URL（保留兼容历史数据）
  attachments Json? // 附件列表 [{name, url}]（回款凭证等，图片或 PDF）
  paidAt     DateTime? @map("paid_at") // 付款日期
  fundAccount String? @map("fund_account") // 资金账户（如 对公账户 / 支付宝）
  refType    String?  @map("ref_type") // 关联单据类型：design | sample（用于费用勾稽）
  refId      String?  @map("ref_id") // 关联单据 id（DesignOrder / SampleOrder id）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@index([refType])
  @@index([refId])
  @@map("fees")
}

/// 设计单：跟踪产品设计任务（设计先于打样）。负责人继承商机负责人；协助负责人为职位「设计」的用户；产品仅关联已有 Product。
model DesignOrder {
  id              String   @id @default(cuid())
  dealId          String   @map("deal_id")
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId       String   @map("product_id") // 关联已有产品（不允许新建）
  product         Product  @relation("ProductDesignOrders", fields: [productId], references: [id])
  productName     String // 完善的产品名称（同步回写 Product.name）
  productType     String // 新品3D开发（设计） | 新品开发（设计）
  responsibleId   String?  @map("responsible_id") // 负责人=商机负责人（继承快照）
  responsible     Contact? @relation("DesignOrderResponsible", fields: [responsibleId], references: [id])
  assistantId     String?  @map("assistant_id") // 协助负责人=职位「设计」
  assistant       Contact? @relation("DesignOrderAssistant", fields: [assistantId], references: [id])
  status          String   @default("draft") // draft|designing|pending_review|approved|rejected
  mainImage       Json? // 产品主图 [{name,url}]
  threeViews      Json? // 三视图+上色位 [{name,url}]
  designFeeAmount Decimal? @db.Decimal(12, 2) @map("design_fee_amount") // 勾稽「设计费」
  dueDate         DateTime? @map("due_date")
  approvedAt      DateTime? @map("approved_at")
  createdBy       String?  @map("created_by")
  deletedAt       DateTime? @map("deleted_at") // 软删
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  samples         SampleOrder[]
  @@index([dealId])
  @@index([productId])
  @@index([responsibleId])
  @@index([assistantId])
  @@map("design_orders")
}

/// 打样单：跟踪实物样品生产与寄送，关联已确认的设计单。负责人继承商机负责人；协助负责人为供应商职位「跟单」。
model SampleOrder {
  id                 String   @id @default(cuid())
  dealId             String   @map("deal_id")
  deal               Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId          String?  @map("product_id") // 落库产品（继承设计单或选）
  product            Product? @relation("ProductSampleOrders", fields: [productId], references: [id])
  designOrderId      String   @map("design_order_id") // 关联已确认设计单（业务必填）
  designOrder        DesignOrder @relation(fields: [designOrderId], references: [id])
  sampleType         String // 11 种打样类型
  responsibleId      String?  @map("responsible_id") // 负责人=商机负责人（继承）
  responsible        Contact? @relation("SampleOrderResponsible", fields: [responsibleId], references: [id])
  assistantId        String?  @map("assistant_id") // 协助负责人=供应商职位「跟单」
  assistant          Contact? @relation("SampleOrderAssistant", fields: [assistantId], references: [id])
  status             String   @default("pending") // pending|sampling|shipped|confirmed|rejected
  colorCode          String?  @map("color_code") // 色号要求
  quantity           Int      @default(1) // 样品数量
  craft              String? // 样品工艺
  material           String? // 材质
  hardness           String? // 硬度
  length             Decimal? @db.Decimal(10, 2) // 产品尺寸-长
  width              Decimal? @db.Decimal(10, 2) // 产品尺寸-宽
  height             Decimal? @db.Decimal(10, 2) // 产品尺寸-高
  requiredCompletion DateTime? @map("required_completion") // 要求完成时间
  orderDate          DateTime? @map("order_date") // 下单日期（默认创建日期）
  functionalReq      String?  @map("functional_req") // 功能要求
  packagingImage     Json? // 包装图 [{name,url}]
  engravingImage     Json? // 底部刻字图 [{name,url}]
  otherAttachments   Json? @map("other_attachments") // 其他附件 [{name,url}]
  acceptanceCriteria String?  @map("acceptance_criteria") // 验收标准
  packagingLength    Decimal? @db.Decimal(10, 2) @map("packaging_length")
  packagingWidth     Decimal? @db.Decimal(10, 2) @map("packaging_width")
  packagingHeight    Decimal? @db.Decimal(10, 2) @map("packaging_height")
  sampleFiles        Json? // 样品照片 [{name,url}]
  trackingNo         String?  @map("tracking_no")
  recipient          String? // 收件信息
  createdBy          String?
  deletedAt          DateTime? @map("deleted_at") // 软删
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([dealId])
  @@index([productId])
  @@index([designOrderId])
  @@index([responsibleId])
  @@index([assistantId])
  @@map("sample_orders")
}

// CRM 阶段停留日志：每次进入某阶段记一条，leftAt 为空表示当前所处阶段。
model DealStageLog {
  id         String   @id @default(cuid())
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId     String
  stage      Stage    @relation(fields: [stageId], references: [id])
  stageId    String
  stageKey   String // 快照阶段 key，阶段被删也不影响展示
  stageTitle String // 快照阶段标题
  enteredAt  DateTime @default(now())
  leftAt     DateTime?

  @@index([dealId])
  @@map("deal_stage_logs")
}

// Chatter 操作/讨论记录：通用挂载到任意业务单据（resModel + resId）。
// 系统机器人（ominXBot）会把「创建 / 字段修改 / 阶段变更」等操作历史写入此处。
model ChatterMessage {
  id          String   @id @default(cuid())
  resModel    String // 业务模型标识，如 "deal"
  resId       String // 业务记录 id（如 deal.id）
  authorId    String? // 作者 Contact id（系统记录用机器人 id；人工评论用登录用户 id）
  authorName  String // 作者名快照（便于展示，避免作者被删后丢失）
  authorIsBot Boolean  @default(false) // 是否系统机器人（ominXBot）发出的操作记录
  authorAvatar String? @map("author_avatar") // 作者头像 URL 快照（如 Accio work 的 web 头像），优先于首字母
  isRecall    Boolean  @default(false) // 是否为「撤回」系统记录（撤回后保留一条提示，仿微信）
  body        String // 消息/操作历史正文
  attachmentName String? @map("attachment_name") // 附件文件名（如报价单 xlsx），由机器人存档消息携带
  attachmentUrl  String? @map("attachment_url") // 附件访问 URL（/uploads/xxx），空表示纯文本
  createdAt   DateTime @default(now())

  @@index([resModel, resId])
  @@map("chatter_messages")
}

// 系统级键值配置（设置页可写）。目前用于存储 MCP Server 的启用状态与访问令牌。
model Setting {
  key        String   @id
  value      String
  updatedAt  DateTime @updatedAt

  @@map("settings")
}

// 报价单：商机推进到「报价」阶段时生成（一商多单）。客户引用商机的客户（同步展示），
// 订单明细为创建时对商机产品需求的快照（linesJson 结构与 Deal 一致），金额由明细派生。
model Quotation {
  id              String    @id @default(cuid())
  number          String    @unique // 报价单号（S00001 起步）
  deal            Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId          String    @map("deal_id")
  contact         Contact?  @relation(fields: [contactId], references: [id])
  contactId       String?   @map("contact_id") // 与商机同步：引用商机选中的客户
  shippingAddress String?   @map("shipping_address") // 收货地址（多行文本，预填客户国家）
  validUntil      DateTime? @map("valid_until") // 有效期至（默认创建 +14 天）
  paymentTerms    String?   @map("payment_terms") // 付款条款
  tradeTerms      String?   @map("trade_terms") // 贸易条款（EXW/FOB/CIF 等）
  deliveryDate    DateTime? @map("delivery_date") // 交付日期
  linesJson       String?   @map("lines_json") // 订单明细（快照，结构同 Deal.linesJson）
  amount          Decimal?  @db.Decimal(12, 2) // 合计（由明细派生：Σ 单价×数量×(1-折扣)）
  notes           String? // 备注
  priceIncludeTax Boolean @default(false) @map("price_include_tax") // 价格是否含税：true=单价含税（倒算税额），false=单价不含税（税额另计）
  templateId      String?  @map("template_id") // 选用的版式模板（QuotationTemplate.id）；为空=使用默认模板
  documentJson    String?  @map("document_json") // 按单编辑后的「冻结副本」（TipTap 文档 JSON）；为空=实时按模板+报价单数据渲染
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([dealId])
  @@index([contactId])
  @@index([templateId])
  @@map("quotations")
}

// 报价单版式模板：可复用的版式 + 合并字段（{{customer.name}} / line.* 等），供多张报价单选择套用。
// 与「文档实例」分离：在弹窗里按单手改生成 quotations.document_json 冻结副本，绝不会回写本表 layout。
model QuotationTemplate {
  id        String   @id @default(cuid())
  name          String // 模板名称（如「标准报价单」「简洁报价单」）
  docType       String   @default("quotation") @map("doc_type") // 适用单据类型：quotation=报价单（预留 sale-order 等）
  sheetSnapshot Json // Univer 工作簿快照（前端 UniverSheetsDemo 的 getSnapshot 产物；旧 TipTap JSON 不含 sheets，前端会忽略并回退默认表格）
  createdAt     DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([docType])
  @@map("quotation_templates")
}

// OAuth 令牌持久化（替代原内存 Map）：access_token 用于鉴权，refresh_token 用于静默续期；
// 同时隐含“授权确认(consent)”记录——存在未过期的 refresh 即代表该用户已授权过该客户端，
// 授权端点可据此自动放行，跳过「允许授权」手动点击。
model OAuthToken {
  id               String   @id @default(cuid())
  userId           String
  clientId         String
  scope            String   @default("mcp")
  accessToken      String   @unique
  refreshToken     String   @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  createdAt        DateTime @default(now())

  @@index([userId, clientId, scope])
  @@map("oauth_tokens")
}

// 会话表：由 connect-pg-simple（express-session 的 PG 存储）自动创建与维护，不归 Prisma 管理。
// 用 @@ignore 让 Prisma 既不纳入客户端、也不在 db push 时被当作漂移删除（避免清空线上会话）。
// 列结构需与 connect-pg-simple 默认一致：sid(PK) / sess(json) / expire(timestamp)。
model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@ignore
  @@map("session")
}
