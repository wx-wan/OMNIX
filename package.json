{
  "name": "omnix",
  "private": true,
  "version": "0.1.0",
  "description": "OMNIX — 前端 React 19 + shadcn/ui (Base UI + Tailwind v4)，后端 NestJS + Prisma + PostgreSQL 的全栈应用。",
  "scripts": {
    "install:all": "npm --prefix client install && npm --prefix server install",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run start:dev",
    "dev": "npm --prefix client run dev & npm --prefix server run start:dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "start:server": "npm --prefix server run start:prod"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "shadcn": "^4.23.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-bold": "file:3.28.0 @tiptap/extension-bubble-menu@3.28.0 @tiptap/extension-code@3.28.0 @tiptap/extension-code-block@3.28.0 @tiptap/extension-document@3.28.0 @tiptap/extension-dropcursor@3.28.0 @tiptap/extension-floating-menu@3.28.0 @tiptap/extension-gapcursor@3.28.0 @tiptap/extension-hard-break@3.28.0 @tiptap/extension-heading@3.28.0 @tiptap/extension-horizontal-rule@3.28.0 @tiptap/extension-image@3.28.0 @tiptap/extension-italic@3.28.0 @tiptap/extension-list-keymap@3.28.0 @tiptap/extension-paragraph@3.28.0 @tiptap/extension-strike@3.28.0 @tiptap/extension-text@3.28.0 @tiptap/extension-text-align@3.28.0 @tiptap/extensions@3.28.0",
    "@tiptap/pm": "^3.28.0"
  }
}
